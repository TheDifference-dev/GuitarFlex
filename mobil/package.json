{
  "name": "guitarflex-mobil",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "icerik": "tsx --tsconfig ../tsconfig.json betikler/icerik-paketle.mts",
    "start": "npm run icerik && expo start",
    "web": "npm run icerik && expo start --web",
    "ios": "npm run icerik && expo run:ios",
    "export:web": "npm run icerik && expo export --platform web",
    "tsc": "tsc --noEmit -p tsconfig.tip.json"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.3.0",
    "expo": "^58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "lucide-react": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15"
  }
}