{
  "name": "guitarflex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-alphatab": "node scripts/copy-alphatab.mjs",
    "postinstall": "npm run copy-alphatab",
    "predev": "npm run copy-alphatab",
    "dev": "next dev",
    "prebuild": "npm run copy-alphatab",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-content": "node --experimental-strip-types scripts/check-content.ts",
    "predesktop": "npm run copy-alphatab",
    "desktop": "electron desktop/main.cjs",
    "desktop:prod": "npm run build && electron desktop/main.cjs --prod",
    "kisayol": "node desktop/kisayol-olustur.cjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.5.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "GuitarFlex — gitar akademisi (masaüstü uygulaması ve web sitesi)",
  "main": "desktop/main.cjs",
  "productName": "GuitarFlex"
}
